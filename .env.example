# FACULTATIF : le projet fonctionne sans fichier .env (Ollama et llama3.2 par défaut).
# Pour utiliser ces réglages, copiez ce fichier en ".env" puis décommentez les lignes voulues.
# Après modification, relancer uvicorn.

# Changer de modèle (il doit avoir été téléchargé avec "ollama pull")
# LLM_MODEL_BIG=llama3.2:3b
# LLM_MODEL_SMALL=llama3.2:1b

# Simuler des incidents (utile pour tester le suivi d'erreurs)
# FAIL_RATE=0.3        # 30 % des appels échouent
# EXTRA_LATENCY=2      # 2 secondes de lenteur ajoutées à chaque appel